"""
OAuth 2.0 Authentication for <%= name %>
"""

import os
from typing import Optional


def validate_bearer_token(headers: dict[str, str]) -> bool:
    """Validate Bearer token from the Authorization header.

    In production, replace this with proper JWT verification
    using a library like PyJWT.
    """
    auth_header = headers.get("authorization", "")
    if not auth_header.startswith("Bearer "):
        return False

    token = auth_header[7:]
    if not token:
        return False

    # TODO: Implement proper token verification
    # Example with PyJWT:
    #   import jwt
    #   secret = os.environ.get("JWT_SECRET")
    #   decoded = jwt.decode(token, secret, algorithms=["HS256"])
    #   return True

    secret = os.environ.get("JWT_SECRET") or os.environ.get("OAUTH_SECRET")
    if not secret:
        print("Warning: JWT_SECRET environment variable not set.")
        return False

    # Placeholder: accept any non-empty token when secret is set
    # Replace with real verification in production
    return len(token) > 0


def get_bearer_token(headers: dict[str, str]) -> Optional[str]:
    """Extract Bearer token from Authorization header."""
    auth_header = headers.get("authorization", "")
    if auth_header.startswith("Bearer "):
        return auth_header[7:]
    return None
