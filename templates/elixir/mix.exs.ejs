defmodule <%= namespace %>.MixProject do
  use Mix.Project

  def project do
    [
      app: :<%= packageName %>,
      version: "1.0.0",
      elixir: "~> 1.15",
      start_permanent: Mix.env() == :prod,
      deps: deps(),
      escript: escript()
    ]
  end

  def application do
    [
      extra_applications: [:logger],
      mod: {<%= namespace %>.Application, []}
    ]
  end

  defp deps do
    [
      {:mcp, "~> 0.1.0"},
      {:jason, "~> 1.4"}
    ]
  end

  defp escript do
    [main_module: <%= namespace %>.CLI]
  end
end
